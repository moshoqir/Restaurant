
@{
    ViewData["Title"] = "Index";
}

<div class="breadcrumb-area bg-img ptb-80" style="background-image:url(/assets/img/banner/breath.jpg);">
    <div class="container">
        <div class="breadcrumb-content text-center">
            <h3>menu</h3>
            <ul>
                <li>
                    <a asp-action="Index" asp-controller="Home">Home</a>
                </li>
                <li class="active">menu page </li>
            </ul>
        </div>
    </div>
</div>
<div class="product-menu-area pt-100 pb-70 gray-bg">
    <div class="container">
        <div class="section-title text-center mb-50">
            <h2>Our Food Menu</h2>
            <p>@Model.SystemSetting.SystemSettingItemMenuDesc </p>
        </div>
        <div class="menu-tab-wrap mb-50">
            <div class="menu-tab-list nav text-center">
                <a class="active" href="#tab1" data-bs-toggle="tab">
                    All item
                </a>
                @foreach (var item in Model.ListMasterCategoryMenu)
                {
                    
                    <a href="#tab-@item.MasterCategoryMenuId" data-bs-toggle="tab">
                        @item.MasterCategoryMenuName
                    </a>
                }
              
            </div>
        </div>
        <div class="tab-content jump">
            <div id="tab1" class="tab-pane active">
                <div class="row">
            @foreach (var item in Model.ListMasterItemMenu)
            {
                
                  
                        <div class="col-lg-6">
                            <a asp-action="Details" asp-route-id="@item.MasterItemMenuId">
                            <div class="single-menu-product mb-30">
                                <div class="menu-product-img">
                                    <img alt="@item.MasterItemMenuTitle" src="~/images/items/@item.MasterItemMenuImageUrl">
                                </div>
                                <div class="menu-product-content">
                                    <div class="menu-title-price">
                                        <div class="menu-title">
                                            <h4>
                                                @item.MasterItemMenuTitle
                                            </h4>
                                        </div>
                                        <div class="menu-price">
                                            <span>$@item.MasterItemMenuPrice</span>
                                        </div>
                                    </div>
                                    <p>Categories: Subway, Masala, Indian</p>
                                </div>
                            </div>
                            </a>
                        </div>

                  
              
            }
                </div>
        </div>
            

            @foreach (var item in Model.ListMasterItemMenu)
            { 
                var items = Model.ListMasterItemMenu.
                Where(x => x.MasterCategoryMenuId == item.MasterCategoryMenuId)
				.ToList();
                
                <div id="tab-@item.MasterCategoryMenu.MasterCategoryMenuId" class="tab-pane">
                    <div class="row">
                        @foreach (var catItem in items)
                        {
                            <div class="col-lg-6">
                                
                                <a asp-action="Details" asp-route-id="@catItem.MasterItemMenuId">
                                <div class="single-menu-product mb-30">
                                    <div class="menu-product-img">
                                        <img alt="@catItem.MasterItemMenuTitle" src="~/images/items/@catItem.MasterItemMenuImageUrl">
                                    </div>
                                    <div class="menu-product-content">
                                        <div class="menu-title-price">
                                            <div class="menu-title">
                                                <h4>
                                                    @catItem.MasterItemMenuTitle
                                                </h4>
                                            </div>
                                            <div class="menu-price">
                                                <span>$@catItem.MasterItemMenuPrice</span>
                                            </div>
                                        </div>
                                        <p>Categories: Subway, Masala, Indian</p>
                                    </div>
                                </div>
                                </a>
                            </div>
                        }
                       

                    </div>
                </div>
            }
            
            
        </div>
    </div>
</div>

<div class="brand-logo-area ptb-100">
    <div class="container">

        <div class="brand-logo-active owl-carousel">

            @foreach (var item in Model.ListMasterPartner)
            {

                <div class="single-brand-logo">
                    <img class="rounded-circle" alt="@item.MasterPartnerName" src="~/images/partners/@item.MasterPartnerLogoImageUrl" title="@item.MasterPartnerName">
                </div>
            }
            @* <div class="single-brand-logo">
                <img alt="" src="~/assets/img/brand-logo/2.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/assets/img/brand-logo/3.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/assets/img/brand-logo/4.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/assets/img/brand-logo/5.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/assets/img/brand-logo/2.png">
            </div> *@
        </div>

    </div>
</div>

