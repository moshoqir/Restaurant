
@{
    ViewData["Title"] = "Index";
}

<div class="breadcrumb-area bg-img ptb-80" style="background-image:url(assets/img/banner/breath.jpg);">
    <div class="container">
        <div class="breadcrumb-content text-center">
            <h3>Contact us</h3>
            <ul>
                <li>
                    <a href="index.html">Home</a>
                </li>
                <li class="active">Contact us</li>
            </ul>
        </div>
    </div>
</div>
<div class="contact-area pt-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="contact-message-wrapper">
                    <h4 class="contact-title mb-25">Leave Us a Message</h4>
                    <div class="contact-message">
                        @using System.Text.Json
                        @using System.Collections.Generic

                        @if (TempData["BookingSuccess"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["BookingSuccess"]
                            </div>
                        }

                        @if (TempData["BookingErrors"] != null)
                        {
                            var dict = JsonSerializer.Deserialize<Dictionary<string, List<string>>>((string)TempData["BookingErrors"]);

                            <div class="alert alert-danger">
                                <ul>
                                    @foreach (var kv in dict)
                                    {
                                        <li>
                                            <strong>@kv.Key</strong>
                                            <ul>
                                                @foreach (var msg in kv.Value)
                                                {
                                                    <li>@msg</li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <form asp-area="Admin" asp-action="Create" asp-controller="TransactionContactUs" method="post">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="contact-form-style mb-20">
                                        <input asp-for="@Model.TransactionContactUs.TransactionContactUsFullName" class="form-control" placeholder="Full Name" type="text" />
                                    </div>
								</div>
                                <div class="col-lg-6">
                                    <div class="contact-form-style mb-20">
                                        <input asp-for="@Model.TransactionContactUs.TransactionContactUsEmail" class="form-control" placeholder="Email Address" type="email" />
                                    </div>
								</div> 
                                <div class="col-lg-12">
                                    <div class="contact-form-style mb-20">
										<input asp-for="@Model.TransactionContactUs.TransactionContactUsSubject" class="form-control" placeholder="Subject" type="text" />
                                    </div>
								</div>
                                <div class="col-lg-12">
                                    <div class="contact-form-style">
                                        <textarea asp-for="@Model.TransactionContactUs.TransactionContactUsMessage" class="form-control"   placeholder="Message"></textarea>
                                        
                                        <button class="submit btn-style" value="Create" type="submit">SEND MESSAGE</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <p class="form-messege"></p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="contact-info-area">
                    <h4 class="contact-title mb-18">Contact Us</h4>
                    <p>@Model.SystemSetting.SystemSettingWelcomeNoteDesc </p>
                    <div class="contact-info-wrap">
                        <div class="single-contact-info mb-40">
                            <div class="contact-info-icon">
                                <i class="fa fa-map-marker"></i>
                            </div>
                            <div class="contact-info-content">
                                <h4>Location :</h4>
                                <p>@Model.SystemSetting.SystemSettingLocationDetails</p>
                            </div>
                        </div>
                        <div class="single-contact-info mb-35">
                            <div class="contact-info-icon">
                                <i class="fa fa-phone"></i>
                            </div>
                            <div class="contact-info-content">
                                <h4>phone :</h4>
                                <p>@Model.SystemSetting.SystemSettingPhone</p>
                                @* <p>+00 111 222 333 44</p> *@
                            </div>
                        </div>
                        <div class="single-contact-info">
                            <div class="contact-info-icon">
                                <i class="fa fa-envelope"></i>
                            </div>
                            <div class="contact-info-content">
                                <h4>mail :</h4>
                                <p><a href="mailto:@Model.SystemSetting.SystemSettingEmail">@Model.SystemSetting.SystemSettingEmail</a></p>
                                @* <p><a href="#">info@example.com</a></p> *@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="map-area pt-100">
            <!--<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d27076.469924029425!2d35.90943985!3d31.97286565!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x151ca00c772c1dd9%3A0x84f783a7c2818f6a!2z2KfZhNi52KjYr9mE2YrYjCDYudmF2ZHYp9mG!5e0!3m2!1sar!2sjo!4v1723388366344!5m2!1sar!2sjo" width="100%" height="600" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>-->


            @Html.Raw(@Model.SystemSetting.SystemSettingMapLocation)
        </div>
    </div>
</div>

