<div class="offer-area gray-bg ptb-100 bg-img" style="background-image:url(/assets/img/banner/offer.jpg);">
    <div class="container">
        <div class="row">
            <div class="xl-auto col-xl-5 ms-auto col-lg-6 col-md-12">
