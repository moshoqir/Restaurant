<div class="about-area ptb-95">
    <div class="container">
        <div class="row d-flex align-items-center">
            <div class="col-lg-6">
                <div class="about-content pr-30">
                    <h2>@Model.SystemSetting.SystemSettingWelcomeNoteTitle </h2>
                    <h3> @Model.SystemSetting.SystemSettingWelcomeNoteBreef  </h3>
                    <div class="about-peragraph">
                        <p>@Model.SystemSetting.SystemSettingWelcomeNoteDesc</p>
                        
                        <div class="default-btn-style mt-35">
                            <a href=@Model.SystemSetting.SystemSettingWelcomeNoteUrl>read more</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-img">
                    <img alt="" src="~/images/systemsetting/@Model.SystemSetting.SystemSettingWelcomeNoteImageUrl">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="popular-product gray-bg pt-100 pb-100">
    <div class="container">
        <div class="section-title text-center mb-50">
            <h2>Our Popular Dishes</h2>
            <p> @Model.SystemSetting.SystemSettingItemMenuDesc</p>
        </div>

        <div class="product-slider-active owl-carousel" >
            @foreach (var item in Model.ListMasterItemMenu)
            {
                <div class="product-style-wrap" style="min-height: 480px; max-height: 450px; display: flex; flex-direction: column;">
                    <img class="img-fluid" alt="@item.MasterItemMenuTitle"
                         src="~/images/items/@item.MasterItemMenuImageUrl"
                         style="height: 290px; object-fit: cover;">
                    <div class="product-content text-center flex-grow-1 d-flex flex-column">
                        <h4 class="mt-2">@item.MasterItemMenuTitle</h4>
                        <p class="flex-grow-1 mb-2">@item.MasterItemMenuDesc</p>
                        <span class="mt-auto">@item.MasterItemMenuPrice $</span>
                    </div>
                </div>
            }
           
        </div>
    </div>
    <div class="popular-bg-img">
        <img alt="" src="assets/img/banner/popular.png">
    </div>
</div>



<div  class="book-table ptb-100 bg-img" id="book" style="background-image:url(/assets/img/banner/book-a-table.jpg);">
    <div class="container">
        <div class="section-title text-center mb-50">
            <h2>book a table</h2>
            <p> @Model.SystemSetting.TransactionBookTableDesc</p>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="reserve-form">
                    @using System.Text.Json
                    @using System.Collections.Generic

                    @if (TempData["BookingSuccess"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["BookingSuccess"]
                        </div>
                    }

                    @if (TempData["BookingErrors"] != null)
                    {
                        var dict = JsonSerializer.Deserialize<Dictionary<string, List<string>>>((string)TempData["BookingErrors"]);

                        <div class="alert alert-danger">
                            <ul>
                                @foreach (var kv in dict)
                                {
                                    <li>
                                        <strong>@kv.Key</strong>
                                        <ul>
                                            @foreach (var msg in kv.Value)
                                            {
                                                <li>@msg</li>
                                            }
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </div>
                    }


                    <h3 class="reserv-title">Reservation Form</h3>
                    <form asp-area="Admin" asp-action="Create" asp-controller="TransactionBookTable" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="reserve-form-top">
                            <input asp-for="@Model.TransactionBookTable.TransactionBookTableFullName" class="form-control" placeholder="Full name" />
                            <input asp-for="@Model.TransactionBookTable.TransactionBookTableEmail" class="form-control" placeholder="Email address" />

                            <input asp-for="@Model.TransactionBookTable.TransactionBookTableMobileNumber" type="number" class="form-control" placeholder="Mobile number" />

                            <div class="date-time">
                                <input asp-for="@Model.TransactionBookTable.TransactionBookTableDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="@Model.TransactionBookTable.TransactionBookTableDate" class="text-danger"></span>


                            </div>
                        </div>
                        <div class="reserve-submit mt-40">
                            <button type="submit"> submit </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="book-img">
                    <img src="~/assets/img/banner/table.png" alt="">
                </div>
            </div>
        </div>
    </div>
</div>
