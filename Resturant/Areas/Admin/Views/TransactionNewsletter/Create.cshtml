@model Resturant.Models.TransactionNewsletter

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TransactionNewsletter</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @using System.Text.Json
        @using System.Collections.Generic

        @if (TempData["BookingSuccess"] != null)
        {
            <div class="alert alert-success">
                @TempData["BookingSuccess"]
            </div>
        }

        @if (TempData["BookingErrors"] != null)
        {
            var dict = JsonSerializer.Deserialize<Dictionary<string, List<string>>>((string)TempData["BookingErrors"]);

            <div class="alert alert-danger">
                <ul>
                    @foreach (var kv in dict)
                    {
                        <li>
                            <strong>@kv.Key</strong>
                            <ul>
                                @foreach (var msg in kv.Value)
                                {
                                    <li>@msg</li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        }
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TransactionNewsletterEmail" class="control-label"></label>
                <input asp-for="TransactionNewsletterEmail" class="form-control" />
                <span asp-validation-for="TransactionNewsletterEmail" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

