@model Resturant.Models.MasterMenu

@{
    ViewData["Title"] = "Create";
}

<h1>Master Menus</h1>

<div class="pagetitle">
    <h1>Create</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="MasterMenu">Master Menu</a> </li>
            <li class="breadcrumb-item">Create</li>


        </ol>

    </nav>
</div>

<hr />




<div class="card">
    <div class="card-body">
        <h5 class="card-title"></h5>

        <!-- Vertical Form -->
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MasterMenuName" class="control-label"></label>
                <input asp-for="MasterMenuName" class="form-control" />
                <span asp-validation-for="MasterMenuName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MasterMenuUrl" class="control-label"></label>
                <input asp-for="MasterMenuUrl" class="form-control" />
                <span asp-validation-for="MasterMenuUrl" class="text-danger"></span>
            </div>
            <div class="text-center mt-3">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button  class="btn btn-secondary" asp-action="Index" asp-controller="MasterMenu">Cancel</button>
            </div>
        </form>
        <!-- Vertical Form -->

    </div>
</div>
