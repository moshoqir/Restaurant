@model Resturant.Models.MasterWorkingHour

@{
    ViewData["Title"] = "Edit";
}

<h1>
    Master Working Hours
</h1>

<div class="pagetitle">
    <h1>Edit</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="MasterWorkingHour">Master Working Hours</a> </li>
            <li class="breadcrumb-item">Edit</li>


        </ol>

    </nav>
</div>

<hr />
 

<div class="card">
    <div class="card-body">
        <h5 class="card-title"></h5>

        <!-- Vertical Form -->
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MasterWorkingHourId" />
            <input type="hidden" asp-for="IsActive" />
            <div class="form-group">
                <label asp-for="MasterWorkingHourName" class="control-label"></label>
                <select asp-for="MasterWorkingHourName" class="form-select">
                   
                    <option value="Sunday">Sunday</option>
                    <option value="Monday">Monday</option>
                    <option value="Tuesday">Tuesday</option>
                    <option value="Wednesday">Wednesday</option>
                    <option value="Thursday">Thursday</option>
                    <option value="Friday">Friday</option>
                    <option value="Saturday">Saturday</option>
                </select>
                <span asp-validation-for="MasterWorkingHourName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MasterWorkingHourTimeFrom" class="control-label"></label>
                <input asp-for="MasterWorkingHourTimeFrom" type="time" class="form-control" />
                <span asp-validation-for="MasterWorkingHourTimeFrom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MasterWorkingHourTimeTo" class="control-label"></label>
                <input asp-for="MasterWorkingHourTimeTo" type="time" class="form-control" />
                <span asp-validation-for="MasterWorkingHourTimeTo" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsClosed" /> @Html.DisplayNameFor(model => model.IsClosed)
                </label>
            </div>
            <div class="text-center mt-3">
                <button type="submit" class="btn btn-primary">Submit</button>
                <a class="btn btn-secondary" asp-action="Index" asp-controller="MasterWorkingHour">Cancel</a>
            </div>
        </form>
        <!-- Vertical Form -->

    </div>
</div>


