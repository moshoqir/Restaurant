@model Resturant.Areas.Admin.ViewModels.MasterFeedbackModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Feedback</h1>

<div class="pagetitle">
    <h1>Edit</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="MasterFeedback">Feedback</a> </li>
            <li class="breadcrumb-item">Edit</li>


        </ol>

    </nav>
</div>

<hr />
<div class="row">
    <div class="col-md-4">
      
    </div>
</div>


<div class="card">
    <div class="card-body">
        <h5 class="card-title"></h5>

        <!-- Vertical Form -->
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MasterFeedbackId" />
            <input type="hidden" asp-for="IsActive" />
            <div class="form-group">
                <label asp-for="MasterFeedbackFullName" class="control-label"></label>
                <input asp-for="MasterFeedbackFullName" class="form-control" />
                <span asp-validation-for="MasterFeedbackFullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Image" class="control-label"></label>
                <br />
                <img src="~/images/feedback/@Html.DisplayFor(model => model.Image)" class="rounded-circle" style="max-width:50px" />
                <input asp-for="File" class="form-control" />

                <span asp-validation-for="File" class="text-danger"></span>
                <input asp-for="Image" type="hidden" />
            </div>
            <div class="form-group">
                <label asp-for="MasterFeedbackType" class="control-label"></label>
                <input asp-for="MasterFeedbackType" class="form-control" />
                <span asp-validation-for="MasterFeedbackType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MasterFeedbackComment" class="control-label"></label>
                <input asp-for="MasterFeedbackComment" class="form-control" />
                <span asp-validation-for="MasterFeedbackComment" class="text-danger"></span>
            </div>

            <div class="text-center mt-3">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button class="btn btn-secondary" asp-action="Index" asp-controller="MasterFeedback">Cancel</button>
            </div>
        </form>
        <!-- Vertical Form -->

    </div>
</div>

