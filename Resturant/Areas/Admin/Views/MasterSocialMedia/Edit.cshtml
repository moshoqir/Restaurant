@model Resturant.Areas.Admin.ViewModels.MasterSocialMediaModel

@{
    ViewData["Title"] = "Edit";
}

<h1>
    Master Social Media
</h1>

<div class="pagetitle">
    <h1>Edit</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Mastersocialmedia">Master Social Media</a> </li>
            <li class="breadcrumb-item">Edit</li>


        </ol>

    </nav>
</div>

<hr />
 

<div class="card">
    <div class="card-body">
        <h5 class="card-title"></h5>

        <!-- Vertical Form -->
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MasterSocialMediaId" />
            <input type="hidden" asp-for=" IsActive " />
            <div class="form-group">
                <label asp-for="MasterSocialMediaImageUrl" class="control-label"></label>
                <br />
                <img src="~/images/socialmedia/@Html.DisplayFor(model => model.MasterSocialMediaImageUrl)" class="rounded-circle" style="max-width:50px" />
                <input asp-for="File" class="form-control" />
                <span asp-validation-for="File" class="text-danger"></span>
                <input type="hidden" asp-for="MasterSocialMediaImageUrl" />
            </div>
            <div class="form-group">
                <label asp-for="MasterSocialMediaUrl" class="control-label"></label>
                <input asp-for="MasterSocialMediaUrl" class="form-control" />
                <span asp-validation-for="MasterSocialMediaUrl" class="text-danger"></span>
            </div>

            <div class="text-center mt-3">
                <button type="submit" class="btn btn-primary">Submit</button>
                <a class="btn btn-secondary" asp-action="Index" asp-controller="Mastersocialmedia">Cancel</a>
            </div>
        </form>
        <!-- Vertical Form -->

    </div>
</div>

